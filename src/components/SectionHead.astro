---
// Шапка раздела: линия, номер и название, справа приписка; ниже заголовок и короткий текст (слот).
// На отдельных страницах (заявка, документы) заголовок — h1: level={1}.
interface Props {
  n: string;
  label: string;
  aside?: string;
  title: string;
  titleId: string;
  level?: 1 | 2;
}

const { n, label, aside, title, titleId, level = 2 } = Astro.props;
const Heading = level === 1 ? "h1" : "h2";
---

<header class="sec-head">
  <div class="sec-head__meta label" data-reveal="text">
    <span><span class="sec-head__n num">{n}</span>{label}</span>
    {aside && <span class="muted">{aside}</span>}
  </div>
  <Heading id={titleId} class="sec-head__title display" data-reveal="text">{title}</Heading>
  {
    Astro.slots.has("default") && (
      <div class="sec-head__text" data-reveal="text">
        <slot />
      </div>
    )
  }
</header>
