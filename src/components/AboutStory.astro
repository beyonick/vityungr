---
// «Обо мне» на /contact — история в три главы.
// Сверху видео на всю ширину, поверх заголовок: обе строки поднимаются по буквам.
// Ниже главы по сетке в 12 колонок, зигзагом: текст и иллюстрация меняются сторонами.
// Только вертикальное движение: появление снизу, без съезда по горизонтали.
import { Image } from "astro:assets";
import windowPhoto from "../assets/vitya/painting-by-window.jpg";
import snow from "../assets/vitya/plein-air-snow.jpg";
import { aboutText } from "../data/about";
import { langOf, tr } from "../i18n";
import { findWork, loadImage, titleOf, workHref } from "../lib/works";
import Chars from "./Chars.astro";
import VideoFrame from "./VideoFrame.astro";

const lang = langOf(Astro.currentLocale);
const t = tr(lang);
const about = aboutText(lang);
const moscow = findWork("originals/moscow/kitay-gorod");
const moscowImg = await loadImage(moscow.images[0].src);
const moscowTitle = titleOf(moscow, lang);

const line1 = `${about.hi}.`;
---

<section class="story" aria-labelledby="about-title" data-story>
  <div class="story__hero pad">
    <div class="story__frame">
      <VideoFrame label={about.video}>
        <p class="story__meta label">
          <span>{about.label}</span>
          <span>{about.college}</span>
        </p>
        <h1 id="about-title" class="story__title display">
          <Chars class="story__line" text={line1} />
          <em><Chars class="story__line" text={`${about.callMe}.`} from={[...line1].length} /></em>
        </h1>
      </VideoFrame>
    </div>
  </div>

  <ol class="story__chapters">
    <li class="chap chap--1 pad">
      <p class="chap__k label" data-reveal="text"><span class="num">01</span>{about.chapters[0]}</p>
      <p class="chap__text" data-reveal="text">{about.story[0]}</p>
      <figure class="chap__fig chap__fig--art" data-reveal>
        <a href={workHref(moscow)}>
          <Image
            src={moscowImg}
            alt={t(`${moscowTitle}, a painting of Moscow`, `${moscowTitle}, картина о Москве`)}
            widths={[400, 700, 1000]}
            sizes="(max-width: 859px) 70vw, 30vw"
            format="webp"
            quality={82}
          />
        </a>
        <figcaption class="chap__cap muted"><em>{moscowTitle}</em>, {about.moscow}</figcaption>
      </figure>
    </li>

    <li class="chap chap--2 pad">
      <figure class="chap__fig chap__fig--photo" data-reveal>
        <Image
          src={snow}
          alt={about.snowAlt}
          widths={[480, 800, 1200]}
          sizes="(max-width: 859px) 100vw, 42vw"
          format="webp"
          quality={80}
        />
        <figcaption class="chap__cap muted">{about.snowCap}</figcaption>
      </figure>
      <p class="chap__k label" data-reveal="text"><span class="num">02</span>{about.chapters[1]}</p>
      <p class="chap__text" data-reveal="text">{about.story[1]}</p>
    </li>

    <li class="chap chap--3 pad">
      <p class="chap__k label" data-reveal="text"><span class="num">03</span>{about.chapters[2]}</p>
      <p class="chap__text" data-reveal="text">{about.story[2]}</p>
      <figure class="chap__fig chap__fig--photo" data-reveal>
        <Image
          src={windowPhoto}
          alt={about.windowAlt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 859px) 100vw, 34vw"
          format="webp"
          quality={80}
        />
        <figcaption class="chap__cap muted">{about.windowCap}</figcaption>
      </figure>
    </li>
  </ol>
</section>

<style>
  /* ---------- Видео с заголовком ---------- */
  .story__hero {
    padding-top: 64px;
  }

  .story__frame {
    height: max(480px, calc(100svh - 64px - var(--gutter)));
  }

  .story__meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    text-align: right;
  }

  .story__title {
    font-size: clamp(2.5rem, 0.9rem + 6.2vw, 8.75rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-wrap: initial;
  }

  .story__title :global(.story__line) {
    display: block;
  }

  .story__title em {
    font-style: italic;
    font-variation-settings: "SOFT" 100, "WONK" 1;
  }

  /* ---------- Главы ---------- */
  .story__chapters {
    padding-top: clamp(120px, 13vw, 220px);
  }

  .chap {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 1.8vw, 28px);
    row-gap: clamp(20px, 2.4vw, 36px);
    align-content: start;
  }

  .chap + .chap {
    margin-top: clamp(120px, 14vw, 240px);
  }

  .chap__k {
    display: flex;
    gap: 0;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .chap__k .num {
    min-width: 3em;
    color: var(--ink-3);
  }

  .chap__text {
    font-family: var(--f-serif);
    font-weight: 340;
    font-size: clamp(1.375rem, 0.95rem + 1.35vw, 2.375rem);
    line-height: 1.22;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .chap__fig :global(img) {
    width: 100%;
    height: auto;
  }

  .chap__fig--art :global(img) {
    box-shadow: var(--shadow-rest);
  }

  .chap__fig--photo :global(img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .chap__cap {
    margin-top: 10px;
    font-size: var(--t-small);
  }

  /* 01: текст слева, картина справа и чуть выше */
  .chap--1 .chap__k {
    grid-column: 1 / span 6;
    grid-row: 1;
    align-self: start;
  }

  .chap--1 .chap__text {
    grid-column: 1 / span 6;
    grid-row: 2;
  }

  .chap--1 .chap__fig {
    grid-column: 9 / span 4;
    grid-row: 1 / span 3;
  }

  /* 02: большое фото слева, текст справа ниже середины */
  .chap--2 .chap__fig {
    grid-column: 1 / span 5;
    grid-row: 1 / span 3;
  }

  .chap--2 .chap__fig :global(img) {
    object-position: 58% 50%;
  }

  .chap--2 .chap__k {
    grid-column: 7 / span 6;
    grid-row: 2;
    align-self: end;
    margin-top: clamp(80px, 12vw, 220px);
  }

  .chap--2 .chap__text {
    grid-column: 7 / span 6;
    grid-row: 3;
  }

  /* 03: текст со второй колонки, фото справа */
  .chap--3 .chap__k {
    grid-column: 2 / span 5;
    grid-row: 1;
  }

  .chap--3 .chap__text {
    grid-column: 2 / span 5;
    grid-row: 2;
  }

  .chap--3 .chap__fig {
    grid-column: 8 / span 4;
    grid-row: 1 / span 3;
    margin-top: clamp(40px, 6vw, 120px);
  }

  .chap--3 .chap__fig :global(img) {
    aspect-ratio: 1;
    object-position: 40% 50%;
  }

  @media (max-width: 859px) {
    .story__frame {
      height: max(440px, 78svh);
    }

    .chap {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .chap .chap__k,
    .chap .chap__text {
      grid-column: 1 / -1;
      margin-top: 0;
    }

    .chap .chap__k {
      grid-row: 1;
    }

    .chap .chap__text {
      grid-row: 2;
    }

    .chap .chap__fig {
      grid-row: 3;
      margin-top: 8px;
    }

    .chap--1 .chap__fig {
      grid-column: 2 / span 4;
    }

    .chap--2 .chap__fig {
      grid-column: 1 / -1;
    }

    .chap--3 .chap__fig {
      grid-column: 2 / -1;
    }
  }
</style>

