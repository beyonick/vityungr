---
import { Image } from "astro:assets";
import { printClub } from "../../data/site";
import { langOf, tr } from "../../i18n";
import { loadImage, prints } from "../../lib/works";
import SectionHead from "../SectionHead.astro";

interface Props {
  n?: string;
}

const { n = "04" } = Astro.props;
const club = prints.find((p) => p.kind === "print-club")!;
const photo = await loadImage(club.images[0].src);
const t = tr(langOf(Astro.currentLocale));
const steps = [
  {
    title: t("I paint from life", "Пишу с натуры"),
    text: t(
      "All month I work outdoors, on new pieces from real observation.",
      "Весь месяц я работаю на пленэре над новыми картинами с натуры.",
    ),
  },
  {
    title: t("I choose the best one", "Выбираю лучшую"),
    text: t(
      "At the end of the month one painting becomes the club print.",
      "В конце месяца одна из картин становится принтом клуба.",
    ),
  },
  {
    title: t("It comes by post", "Принт приходит по почте"),
    text: t(
      "A 5×7 print, signed and limited, in your mailbox. Collect a whole year.",
      "Подписанный принт 5×7 дюймов ограниченным тиражом — прямо в почтовый ящик. Соберите целый год.",
    ),
  },
];
---

<section class="section club" id="print-club" aria-labelledby="club-title">
  <SectionHead
    n={n}
    label={t("Print Club", "Принт-клуб")}
    aside={t("Monthly subscription", "Ежемесячная подписка")}
    title={t("Vityungr Print Club", "Принт-клуб Vityungr")}
    titleId="club-title"
  >
    <p>
      {
        t(
          "The easiest way to own my work. Every month members get a print of the best painting I made that month.",
          "Самый простой способ получить мою работу. Каждый месяц участники клуба получают принт лучшей картины, написанной за этот месяц.",
        )
      }
    </p>
  </SectionHead>

  <div class="club__body pad">
    <figure class="club__photo" data-reveal>
      <Image
        src={photo}
        alt={t(
          "Print Club envelopes with signed prints, ready to be posted",
          "Конверты принт-клуба с подписанными принтами, готовые к отправке",
        )}
        widths={[480, 800, 1200]}
        sizes="(max-width: 859px) 92vw, 44vw"
        format="webp"
        quality={80}
      />
    </figure>

    <div class="club__text" data-reveal="text">
      <ol class="club__steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="label num club__n">0{i + 1}</span>
              <div>
                <h3 class="club__step display">{s.title}</h3>
                <p class="muted">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <ul class="club__links">
        <li>
          <a class="tlink" href={printClub.patreon} rel="noopener" target="_blank">
            {t("Join on Patreon", "Вступить на Patreon")}
            <span class="sr-only">{t(" (opens in a new tab)", " (откроется в новой вкладке)")}</span>
          </a>
        </li>
        <li>
          <a class="tlink" href={printClub.paypal} rel="noopener" target="_blank">
            {t("Join with PayPal", "Вступить через PayPal")}
            <span class="sr-only">{t(" (opens in a new tab)", " (откроется в новой вкладке)")}</span>
          </a>
        </li>
      </ul>
      <p class="club__note muted">
        {
          t(
            "Patreon members also get process timelapses and notes on how each piece was painted.",
            "Участники на Patreon также получают таймлапсы процесса и заметки о том, как писалась каждая работа.",
          )
        }
      </p>
    </div>
  </div>
</section>

<style>
  .club__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 1.8vw, 28px);
    align-items: end;
  }

  .club__photo {
    grid-column: 1 / span 5;
    box-shadow: var(--shadow-rest);
  }

  .club__photo :global(img) {
    width: 100%;
  }

  .club__text {
    grid-column: 7 / span 6;
  }

  .club__steps {
    border-top: 1px solid var(--line);
  }

  .club__steps li {
    display: grid;
    grid-template-columns: clamp(48px, 5vw, 80px) minmax(0, 1fr);
    padding-block: clamp(20px, 2.4vw, 32px);
    border-bottom: 1px solid var(--line);
  }

  .club__n {
    padding-top: 0.9em;
    color: var(--ink-3);
  }

  .club__step {
    font-size: clamp(1.6rem, 1rem + 2vw, 2.9rem);
    line-height: 1.05;
    margin-bottom: 10px;
  }

  .club__steps p {
    font-size: 1rem;
    max-width: 44ch;
  }

  .club__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    margin-top: 24px;
    font-size: var(--t-small);
  }

  .club__note {
    margin-top: 10px;
    font-size: var(--t-small);
    max-width: 44ch;
  }

  @media (max-width: 859px) {
    .club__body {
      display: block;
    }

    .club__text {
      margin-top: 40px;
    }
  }
</style>
