---
// Все серии с числом работ — над стеной на /works и на страницах серий
import { series, seriesText } from "../data/series";
import { langOf, tr } from "../i18n";
import { availableWorks, worksIn } from "../lib/works";
import ChipNav from "./ChipNav.astro";

interface Props {
  /** slug открытой серии; без него открыта /works */
  current?: string;
}

const { current } = Astro.props;
const lang = langOf(Astro.currentLocale);
const t = tr(lang);
const links = [
  { href: "/works", label: t("Available now", "Сейчас в продаже"), count: availableWorks().length, active: !current },
  ...series.map((s) => ({
    href: `/works/${s.slug}`,
    label: seriesText(s, lang).title,
    count: worksIn(s.slug).length,
    active: s.slug === current,
  })),
];
---

<ChipNav label={t("Series", "Серии")} links={links} />
