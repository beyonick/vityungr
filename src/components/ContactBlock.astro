---
// Блок «Write to me»: почта, соцсети, поддержка, мастерская. Стоит в подвале каждой страницы.
import { printClub, site, social } from "../data/site";
import { langOf, tr } from "../i18n";
import SectionHead from "./SectionHead.astro";

const lang = langOf(Astro.currentLocale);
const t = tr(lang);
---

<SectionHead
  n="07"
  label={t("Contact", "Контакты")}
  aside={t("Questions, orders, shipping", "Вопросы, заказы, доставка")}
  title={t("Write to me", "Напишите мне")}
  titleId="contact-title"
>
  {
    lang === "ru" ? (
      <Fragment>
        <p>Отвечаю на все письма сам, обычно в течение пары дней.</p>
        <p>
          Чтобы купить картину или принт, отправьте <a class="ulink" href="/order">заявку</a> — я отвечу по почте.
        </p>
        <p>Галереи, выставки и сотрудничество — на этот же адрес.</p>
      </Fragment>
    ) : (
      <Fragment>
        <p>I answer every message myself, usually within a couple of days.</p>
        <p>
          To buy a painting or a print, send a <a class="ulink" href="/order">request</a>: I’ll reply by email.
        </p>
        <p>Galleries, exhibitions and collaborations: the same address.</p>
      </Fragment>
    )
  }
</SectionHead>

<p class="ftr__mailrow pad" data-reveal="text">
  <a class="ftr__mail serif" href={`mailto:${site.email}`}>{site.email}</a>
</p>

<div class="ftr__cols pad" data-reveal="text">
  <div>
    <p class="label muted">{t("Follow", "Соцсети")}</p>
    <ul>
      {
        social.map((s) => (
          <li>
            <a class="tlink" href={s.href} rel="noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div>
    <p class="label muted">{t("Support", "Поддержать")}</p>
    <ul>
      <li><a class="tlink" href={printClub.patreon} rel="noopener" target="_blank">Patreon</a></li>
      <li><a class="tlink" href={printClub.boosty} rel="noopener" target="_blank">Boosty</a></li>
      <li><a class="tlink" href="/prints#print-club">{t("Print Club", "Принт-клуб")}</a></li>
    </ul>
  </div>
  <div>
    <p class="label muted">{t("Studio", "Мастерская")}</p>
    <p>{t(site.location, site.locationRu)}</p>
    <p class="muted">{t("Packed within 1–3 working days", "Упаковываю за 1–3 рабочих дня")}</p>
    <p><a class="tlink" href="/shipping">{t("Shipping and FAQ", "Доставка и вопросы")}</a></p>
  </div>
</div>

<style>
  /* Почта — крупно, на всю ширину */
  .ftr__mailrow {
    margin-bottom: clamp(48px, 6vw, 96px);
  }

  .ftr__mail {
    display: inline-block;
    color: var(--ink);
    font-size: clamp(1.6rem, 0.5rem + 5.4vw, 6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    transition: background-size 0.5s var(--ease-out);
    overflow-wrap: anywhere;
  }

  .ftr__mail:hover {
    background-size: 0 1px;
    background-position: 100% 100%;
  }

  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 1.8vw, 28px);
    font-size: var(--t-small);
  }

  .ftr__cols > div:nth-child(1) {
    grid-column: 8 / span 2;
  }

  .ftr__cols > div:nth-child(2) {
    grid-column: 10 / span 1;
  }

  .ftr__cols > div:nth-child(3) {
    grid-column: 11 / span 2;
  }

  .ftr__cols .label {
    margin-bottom: 8px;
  }

  .ftr__cols .tlink {
    min-height: 26px;
  }

  @media (max-width: 1099px) {
    .ftr__cols {
      display: flex;
      flex-wrap: wrap;
      gap: 28px 56px;
    }
  }
</style>
