---
// Блок «Write to me»: почта, соцсети, поддержка, мастерская.
// Стоит в подвале каждой страницы, а на /contact — первым на странице (level={1}), подвал там короткий.
import { printClub, site, social } from "../data/site";
import SectionHead from "./SectionHead.astro";

interface Props {
  n?: string;
  level?: 1 | 2;
}

const { n = "07", level = 2 } = Astro.props;
---

<SectionHead n={n} label="Contact" aside="Questions, orders, shipping" title="Write to me" titleId="contact-title" level={level}>
  <p>I answer every message myself, usually within a couple of days.</p>
  <p>To buy a painting or a print, send a <a class="ulink" href="/order">request</a>: I’ll reply by email.</p>
  <p>Galleries, exhibitions and collaborations: the same address.</p>
  <p><a class="ftr__mail serif" href={`mailto:${site.email}`}>{site.email}</a></p>
</SectionHead>

<div class="ftr__cols pad" data-reveal="text">
  <div>
    <p class="label muted">Follow</p>
    <ul>
      {
        social.map((s) => (
          <li>
            <a class="tlink" href={s.href} rel="noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div>
    <p class="label muted">Support</p>
    <ul>
      <li><a class="tlink" href={printClub.patreon} rel="noopener" target="_blank">Patreon</a></li>
      <li><a class="tlink" href={printClub.boosty} rel="noopener" target="_blank">Boosty</a></li>
      <li><a class="tlink" href="/prints#print-club">Print Club</a></li>
    </ul>
  </div>
  <div>
    <p class="label muted">Studio</p>
    <p>{site.location}</p>
    <p class="muted">Packed within 1–3 working days</p>
    <p><a class="tlink" href="/shipping">Shipping and FAQ</a></p>
  </div>
</div>

<style>
  .ftr__mail {
    display: inline-block;
    margin-top: 6px;
    color: var(--ink);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.2;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    overflow-wrap: anywhere;
  }

  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 1.8vw, 28px);
    font-size: var(--t-small);
  }

  .ftr__cols > div:nth-child(1) {
    grid-column: 8 / span 2;
  }

  .ftr__cols > div:nth-child(2) {
    grid-column: 10 / span 1;
  }

  .ftr__cols > div:nth-child(3) {
    grid-column: 11 / span 2;
  }

  .ftr__cols .label {
    margin-bottom: 8px;
  }

  .ftr__cols .tlink {
    min-height: 26px;
  }

  @media (max-width: 1099px) {
    .ftr__cols {
      display: flex;
      flex-wrap: wrap;
      gap: 28px 56px;
    }
  }
</style>
