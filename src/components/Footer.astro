---
// Подвал: блок контактов и строка с документами. compact — только строка (на /contact блок уже вверху).
import { site } from "../data/site";
import ContactBlock from "./ContactBlock.astro";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class:list={["ftr", { section: !compact, "ftr--compact": compact }]}
  id={compact ? undefined : "contact"}
  aria-labelledby={compact ? undefined : "contact-title"}
>
  {!compact && <ContactBlock />}

  <div class="ftr__base pad label muted">
    <span>© {year} {site.fullName}</span>
    <span class="ftr__legal">
      <a href="/privacy">Privacy policy</a>
      <a href="/consent">Consent to data processing</a>
    </span>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>

<style>
  .ftr {
    padding-bottom: 20px;
  }

  .ftr__base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(56px, 7vw, 100px);
    padding-top: 14px;
    border-top: 1px solid var(--line);
    margin-inline: var(--gutter);
    padding-inline: 0;
  }

  .ftr__base a {
    color: var(--ink);
  }

  .ftr__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }

  .ftr__legal a {
    color: var(--ink-2);
    transition: color 0.3s var(--ease-soft);
  }

  .ftr__legal a:hover {
    color: var(--ink);
  }

  @media (max-width: 599px) {
    .ftr__base {
      flex-direction: column;
    }
  }

  .ftr--compact .ftr__base {
    margin-top: clamp(96px, 10vw, 160px);
  }
</style>
