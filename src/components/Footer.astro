---
import { printClub, site, social } from "../data/site";
import SectionHead from "./SectionHead.astro";

const year = new Date().getFullYear();
---

<footer class="ftr section" id="contact" aria-labelledby="contact-title">
  <SectionHead n="07" label="Contact" aside="Questions, orders, shipping" title="Write to me" titleId="contact-title">
    <p>I answer every message myself, usually within a couple of days.</p>
    <p><a class="ftr__mail serif" href={`mailto:${site.email}`}>{site.email}</a></p>
  </SectionHead>

  <div class="ftr__cols pad" data-reveal="text">
    <div>
      <p class="label muted">Follow</p>
      <ul>
        {
          social.map((s) => (
            <li>
              <a class="tlink" href={s.href} rel="noopener" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="label muted">Support</p>
      <ul>
        <li><a class="tlink" href={printClub.patreon} rel="noopener" target="_blank">Patreon</a></li>
        <li><a class="tlink" href={printClub.boosty} rel="noopener" target="_blank">Boosty</a></li>
      </ul>
    </div>
    <div>
      <p class="label muted">Studio</p>
      <p>{site.location}</p>
      <p class="muted">Packed within 1–3 working days</p>
    </div>
  </div>

  <div class="ftr__base pad label muted">
    <span>© {year} {site.fullName}</span>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>

<style>
  .ftr {
    padding-bottom: 20px;
  }

  .ftr__mail {
    display: inline-block;
    margin-top: 6px;
    color: var(--ink);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.2;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    overflow-wrap: anywhere;
  }

  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 1.8vw, 28px);
    font-size: var(--t-small);
  }

  .ftr__cols > div:nth-child(1) {
    grid-column: 8 / span 2;
  }

  .ftr__cols > div:nth-child(2) {
    grid-column: 10 / span 1;
  }

  .ftr__cols > div:nth-child(3) {
    grid-column: 11 / span 2;
  }

  .ftr__cols .label {
    margin-bottom: 8px;
  }

  .ftr__cols .tlink {
    min-height: 26px;
  }

  .ftr__base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(56px, 7vw, 100px);
    padding-top: 14px;
    border-top: 1px solid var(--line);
    margin-inline: var(--gutter);
    padding-inline: 0;
  }

  .ftr__base a {
    color: var(--ink);
  }

  @media (max-width: 1099px) {
    .ftr__cols {
      display: flex;
      flex-wrap: wrap;
      gap: 28px 56px;
    }
  }
</style>
