---
// Подвал: чёрный, на всех страницах. Блок контактов, пункты меню, строка с документами и подпись автора сайта.
import { nav, site } from "../data/site";
import { langOf, tr } from "../i18n";
import ContactBlock from "./ContactBlock.astro";

const t = tr(langOf(Astro.currentLocale));

const year = new Date().getFullYear();
---

<footer class="ftr" id="contact" aria-labelledby="contact-title">
  <ContactBlock />

  <nav class="ftr__nav pad" aria-label={t("Footer", "Меню в подвале")}>
    <ul>
      {
        nav.map((l) => (
          <li>
            <a class="serif" href={l.href}>
              {t(l.label, l.labelRu)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="ftr__base pad label muted">
    <span>© {year} {t(site.fullName, site.fullNameRu)}</span>
    <span class="ftr__legal">
      <a href="/privacy">{t("Privacy policy", "Политика конфиденциальности")}</a>
      <a href="/consent">{t("Consent to data processing", "Согласие на обработку данных")}</a>
    </span>
    <a href="#top">{t("Back to top ↑", "Наверх ↑")}</a>
  </div>

  <p class="ftr__credit pad muted">
    {t("Made with love and attention to every detail.", "Сделано с любовью и вниманием к каждой детали.")}{" "}
    <a href="https://nicktmsh.com" rel="noopener" target="_blank">
      nicktmsh<span class="sr-only">{t(" (opens in a new tab)", " (откроется в новой вкладке)")}</span>
    </a>
  </p>
</footer>

<style>
  /* Тёмная тема только внутри подвала: те же токены, другие значения */
  .ftr {
    --bg: #000;
    --ink: #fff;
    --ink-2: #9a9a9a;
    --ink-3: #666;
    --line: rgb(255 255 255 / 0.18);

    color-scheme: dark;
    margin-top: clamp(96px, 10vw, 160px);
    padding-top: clamp(80px, 9vw, 150px);
    padding-bottom: 20px;
    background: var(--bg);
    color: var(--ink);
  }

  .ftr__nav {
    margin-top: clamp(72px, 8vw, 128px);
  }

  .ftr__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(24px, 3vw, 48px);
  }

  .ftr__nav a {
    display: inline-block;
    padding-block: 4px;
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    line-height: 1.2;
    color: var(--ink-2);
    transition: color 0.3s var(--ease-soft);
  }

  .ftr__nav a:hover {
    color: var(--ink);
  }

  .ftr__base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(40px, 5vw, 72px);
    padding-top: 14px;
    border-top: 1px solid var(--line);
    margin-inline: var(--gutter);
    padding-inline: 0;
  }

  .ftr__base a {
    color: var(--ink);
  }

  .ftr__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }

  .ftr__legal a {
    color: var(--ink-2);
    transition: color 0.3s var(--ease-soft);
  }

  .ftr__legal a:hover {
    color: var(--ink);
  }

  /* Подпись автора сайта: обычным мелким текстом, имя — белым, на наведении подчёркивается */
  .ftr__credit {
    margin: 14px var(--gutter) 0;
    padding-inline: 0;
    font-size: var(--t-small);
  }

  .ftr__credit a {
    color: var(--ink);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.4s var(--ease-out);
  }

  .ftr__credit a:hover {
    background-size: 100% 1px;
  }

  @media (max-width: 599px) {
    .ftr__base {
      flex-direction: column;
    }
  }
</style>
