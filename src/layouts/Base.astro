---
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";
import "@fontsource-variable/schibsted-grotesk";
import "../styles/global.css";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ArtOverlay from "../components/ArtOverlay.astro";
import { site } from "../data/site";
import { langOf, pathIn, stripLang, tr } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  /** Страница, на которой лежат разделы (меню ведёт к якорям на ней самой) */
  home?: boolean;
  /** Служебная страница — не для поиска */
  noindex?: boolean;
  /** Картинка для превью ссылки в мессенджерах и соцсетях (путь или адрес) */
  image?: string;
}

const lang = langOf(Astro.currentLocale);
const t = tr(lang);
const { title, description = t(site.description, site.descriptionRu), home = false, noindex = false, image } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${t(site.tagline, site.taglineRu)}`;
// адрес страницы без языка: по нему строим ссылки на обе версии (в dev русская страница — подмена английской)
const bare = stripLang(Astro.originPathname ?? Astro.url.pathname);
const canonical = new URL(pathIn(lang, bare), Astro.site);
const alternates = (["en", "ru"] as const).map((l) => ({ lang: l, href: new URL(pathIn(l, bare), Astro.site) }));
const ogImage = image ? new URL(image, Astro.site) : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t("en_US", "ru_RU")} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    <slot name="head" />
    <script is:inline>
      // JS есть — прячем то, что появится при скролле. Если скрипты не стартуют за 2.5 с, показываем всё.
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) d.classList.add("no-motion");
        window.__motionFallback = setTimeout(function () {
          d.classList.add("no-motion");
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t("Skip to content", "К содержанию")}</a>
    <Header home={home} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ArtOverlay />
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
