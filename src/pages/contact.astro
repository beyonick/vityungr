---
// «Обо мне» и контакты: история (видео, три главы), а «Write to me» — в подвале, как на всех страницах.
import AboutStory from "../components/AboutStory.astro";
import { langOf, tr } from "../i18n";
import Base from "../layouts/Base.astro";

const t = tr(langOf(Astro.currentLocale));
---

<Base
  title={t("Contact", "Контакты")}
  description={t(
    "Write to Vityungr (Viktor Grachev), a plein-air painter based in Montenegro: email, social media, requests and collaborations.",
    "Напишите Vityungr (Виктору Грачёву), художнику-пленэристу из Черногории: почта, соцсети, заявки и сотрудничество.",
  )}
>
  <AboutStory />
</Base>
