---
// Доставка и вопросы. Как устроен заказ, упаковка, США и Канада, условия принтов — со старого сайта
// (vityungr.website/orderdelivery, /prints, /sale). Стоимость доставки оригиналов, таможня, бронь
// и возврат — черновики: на старом сайте их не было, сверить с Витей.
import SectionHead from "../components/SectionHead.astro";
import Base from "../layouts/Base.astro";
import { printClub, site } from "../data/site";
import { langOf, tr } from "../i18n";

const t = tr(langOf(Astro.currentLocale));

const steps = [
  {
    title: t("You send a request", "Вы отправляете заявку"),
    text: t(
      "Choose a painting and send a request from its page. It doesn’t require payment. Please double-check your email: that’s where I’ll reply.",
      "Выберите картину и отправьте заявку с её страницы. Платить ничего не нужно. Проверьте адрес почты — ответ придёт туда.",
    ),
  },
  {
    title: t("We agree on the details", "Договариваемся о деталях"),
    text: t(
      "I write to you personally, usually within a couple of days, to confirm the address, shipping, currency and payment method, whatever works best for you.",
      "Я пишу вам лично, обычно в течение пары дней, чтобы уточнить адрес, доставку, валюту и способ оплаты — как вам удобнее.",
    ),
  },
  {
    title: t("I pack and ship", "Упаковываю и отправляю"),
    text: t(
      "Once the payment is done, I prepare your parcel within 1–3 working days. Every piece is carefully wrapped by hand and sent as soon as possible.",
      "После оплаты я готовлю посылку за 1–3 рабочих дня. Каждую работу аккуратно упаковываю вручную и отправляю как можно скорее.",
    ),
  },
];

const link = (href: string, label: string) => `<a href="${href}" target="_blank" rel="noopener">${label}</a>`;

// html — свои тексты, без пользовательского ввода
const groups = [
  {
    label: t("Shipping", "Доставка"),
    items: [
      {
        q: t("Where do you ship?", "Куда вы отправляете?"),
        a: t(
          "Worldwide. The only exception for now is the US and Canada: I can’t send originals and large posters there yet, and I’m working on it. Small prints (9 × 12 in and A4) and Print Club prints do go to the US and Canada.",
          "По всему миру. Пока исключение — США и Канада: туда я ещё не могу отправлять оригиналы и большие постеры, но работаю над этим. Небольшие принты (9 × 12 дюймов и A4) и принты клуба в США и Канаду отправляются.",
        ),
      },
      {
        q: t("How much does shipping cost?", "Сколько стоит доставка?"),
        a: t(
          "For originals it depends on the size of the painting and the country. I’ll tell you the exact cost before you pay. Shipping for prints is free worldwide.",
          "Для оригиналов — зависит от размера картины и страны. Точную стоимость я назову до оплаты. Доставка принтов по всему миру бесплатная.",
        ),
      },
      {
        q: t("How long does delivery take?", "Сколько идёт посылка?"),
        a: t(
          "I pack every order within 1–3 working days after payment. After that it depends on your country and the postal service. I’ll email you when the parcel is on its way.",
          "Каждый заказ я упаковываю за 1–3 рабочих дня после оплаты. Дальше всё зависит от страны и почтовой службы. Когда посылка отправится, я напишу вам.",
        ),
      },
      {
        q: t("How are paintings packed?", "Как упаковываются картины?"),
        a: t(
          "Every piece is carefully wrapped by hand before it goes to the post office.",
          "Каждую работу я аккуратно упаковываю вручную, прежде чем отнести на почту.",
        ),
      },
    ],
  },
  {
    label: t("Payment", "Оплата"),
    items: [
      {
        q: t("Do I pay when I send a request?", "Нужно ли платить при отправке заявки?"),
        a: t(
          "No. A request doesn’t commit you to anything. I’ll email you, and you pay only when we’ve agreed on everything.",
          "Нет. Заявка ни к чему не обязывает. Я напишу вам, а оплата — только когда мы обо всём договоримся.",
        ),
      },
      {
        q: t("How can I pay?", "Как можно оплатить?"),
        a: t(
          "We choose together by email: the currency and the payment method that work best for you.",
          "Выбираем вместе по почте: валюту и способ оплаты, удобные вам.",
        ),
      },
      {
        q: t("Can you hold a painting for me?", "Можно забронировать картину?"),
        a: t(
          "Yes. While we’re agreeing on the details, I mark the painting as reserved, so nobody else can request it.",
          "Да. Пока мы договариваемся о деталях, я отмечаю картину как забронированную, и никто другой не сможет оставить на неё заявку.",
        ),
      },
    ],
  },
  {
    label: t("Customs", "Таможня"),
    items: [
      {
        q: t("Will I have to pay customs duties?", "Придётся ли платить таможенную пошлину?"),
        a: t(
          "Parcels go from Montenegro, which is not in the EU. Depending on your country’s rules, customs may charge import duty or VAT on delivery; this is paid by the recipient. If you’re not sure, ask me before ordering.",
          "Посылки идут из Черногории, которая не входит в ЕС. В зависимости от правил вашей страны таможня может взять при получении ввозную пошлину или НДС — их оплачивает получатель. Если не уверены, спросите меня до заказа.",
        ),
      },
    ],
  },
  {
    label: t("Returns", "Возврат"),
    items: [
      {
        q: t("What if the painting arrives damaged?", "Что, если картина приедет повреждённой?"),
        a: t(
          "Write to me as soon as you can, ideally within a few days of delivery, and attach photos of the parcel and the damage. We’ll sort it out together: I’ll refund you or find another solution.",
          "Напишите мне как можно скорее, лучше в течение нескольких дней после получения, и приложите фото посылки и повреждений. Разберёмся вместе: я верну деньги или найду другое решение.",
        ),
      },
      {
        q: t("Can I return a painting?", "Можно вернуть картину?"),
        a: t(
          "Yes, within 14 days of delivery, if it’s in the same condition. Write to me first. Return shipping is paid by the buyer, and I refund the price of the painting once it’s back with me.",
          "Да, в течение 14 дней после получения, если она в том же состоянии. Сначала напишите мне. Обратную доставку оплачивает покупатель, а стоимость картины я верну, как только она вернётся ко мне.",
        ),
      },
    ],
  },
  {
    label: t("Prints and Print Club", "Принты и принт-клуб"),
    items: [
      {
        q: t("What are the prints like?", "Какие принты?"),
        a: t(
          "Every print is hand-signed and numbered, on 200–240 gsm matte or semi-matte paper. They come with white borders, since every painting has its own proportions.",
          "Каждый принт подписан от руки и пронумерован, на матовой или полуматовой бумаге 200–240 г/м². Они печатаются с белыми полями, потому что у каждой картины свои пропорции.",
        ),
      },
      {
        q: t("What is a limited batch?", "Что такое ограниченный тираж?"),
        a: t(
          "Some prints are made in batches of five pieces. When a batch is gone, it sometimes comes back in stock, again only five.",
          "Некоторые принты печатаются тиражом в пять штук. Когда тираж заканчивается, он иногда появляется снова — и снова только пять штук.",
        ),
      },
      {
        q: t("How does the Print Club work?", "Как работает принт-клуб?"),
        a: t(
          `Every month I choose the best painting I made from life, and members get a signed, limited 5 × 7 print of it by mail. You can join through ${link(printClub.patreon, "Patreon")} (with bonus content), ${link(printClub.paypal, "PayPal")} or ${link(printClub.boosty, "Boosty")}, and cancel there at any time.`,
          `Каждый месяц я выбираю лучшую картину, написанную с натуры, и участники получают по почте её подписанный принт 5 × 7 дюймов ограниченным тиражом. Вступить можно через ${link(printClub.patreon, "Patreon")} (с бонусными материалами), ${link(printClub.paypal, "PayPal")} или ${link(printClub.boosty, "Boosty")} и отменить подписку там же в любой момент.`,
        ),
      },
    ],
  },
  {
    label: t("Your details", "Ваши данные"),
    items: [
      {
        q: t("What do you do with my details?", "Что вы делаете с моими данными?"),
        a: t(
          `I use them only to answer your request and to ship the painting. Nothing goes to advertisers. See the <a href="/privacy">privacy policy</a>.`,
          `Я использую их только чтобы ответить на заявку и отправить картину. Рекламщикам ничего не передаётся. Подробнее — в <a href="/privacy">политике конфиденциальности</a>.`,
        ),
      },
    ],
  },
];
---

<Base
  title={t("Shipping and FAQ", "Доставка и вопросы")}
  description={t(
    "How ordering a painting from Vityungr works: requests without payment, packing, worldwide shipping, customs, returns, prints and the Print Club.",
    "Как устроен заказ картины у Vityungr: заявка без оплаты, упаковка, доставка по миру, таможня, возврат, принты и принт-клуб.",
  )}
>
  <section class="faq" aria-labelledby="faq-title">
    <SectionHead
      n="—"
      label={t("Help", "Помощь")}
      aside={t("Originals · Prints · Print Club", "Оригиналы · Принты · Принт-клуб")}
      title={t("Shipping and questions", "Доставка и вопросы")}
      titleId="faq-title"
      level={1}
    >
      <p>
        {
          t(
            "How ordering works, where I ship, and what happens if something goes wrong.",
            "Как устроен заказ, куда я отправляю и что делать, если что-то пошло не так.",
          )
        }
      </p>
      <p>
        {t("Didn’t find your answer? Write to me at", "Не нашли ответа? Напишите мне на")}{" "}
        <a class="ulink" href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </SectionHead>

    <!-- Как устроен заказ -->
    <div class="faq__row" data-reveal="text">
      <h2 class="faq__label label"><span class="faq__n num">01</span>{t("How it works", "Как это работает")}</h2>
      <ol class="faq__steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="label num faq__step-n">0{i + 1}</span>
              <div>
                <h3 class="faq__step display">{s.title}</h3>
                <p class="muted">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="faq__cta">
        <a class="faq__btn" href="/works">
          <span>{t("See available works", "Смотреть работы в продаже")}</span>
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    <!-- Вопросы -->
    {
      groups.map((g, i) => (
        <div class="faq__row" data-reveal="text">
          <h2 class="faq__label label">
            <span class="faq__n num">{String(i + 2).padStart(2, "0")}</span>
            {g.label}
          </h2>
          <div class="faq__list">
            {g.items.map((item) => (
              <details class="faq__item">
                <summary>
                  <span>{item.q}</span>
                  <span class="faq__icon" aria-hidden="true" />
                </summary>
                <p class="faq__answer" set:html={item.a} />
              </details>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .faq {
    padding-top: clamp(120px, 16vh, 180px);
  }

  /* Ряд: слева номер и тема, справа содержимое — как шаги формы заявки */
  .faq__row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 1.8vw, 28px);
    margin-inline: var(--gutter);
    padding: 14px 0 clamp(44px, 5vw, 72px);
    border-top: 1px solid var(--line);
  }

  .faq__label {
    grid-column: 1 / span 3;
    font-weight: 540;
  }

  .faq__n {
    display: inline-block;
    min-width: 3em;
    color: var(--ink-3);
  }

  .faq__steps,
  .faq__list,
  .faq__cta {
    grid-column: 4 / -1;
    max-width: 860px;
  }

  /* ---------- Шаги ---------- */
  .faq__steps li {
    display: grid;
    grid-template-columns: clamp(48px, 5vw, 80px) minmax(0, 1fr);
    padding-block: clamp(18px, 2.2vw, 28px);
    border-bottom: 1px solid var(--line);
  }

  .faq__steps li:first-child {
    padding-top: 0;
  }

  .faq__step-n {
    padding-top: 0.9em;
    color: var(--ink-3);
  }

  .faq__step {
    margin-bottom: 8px;
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    line-height: 1.05;
  }

  .faq__steps p {
    max-width: 52ch;
    font-size: 1rem;
  }

  .faq__cta {
    margin-top: clamp(24px, 2.6vw, 36px);
  }

  .faq__btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    padding: 0 28px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-size: var(--t-text);
    transition:
      background-color 0.35s var(--ease-soft),
      color 0.35s var(--ease-soft);
  }

  .faq__btn:hover {
    background: var(--ink);
    color: var(--bg);
  }

  /* ---------- Вопросы ---------- */
  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  .faq__item:first-child summary {
    padding-top: 0;
  }

  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding-block: 16px;
    font-size: 1rem;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
    transition: color 0.3s var(--ease-soft);
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:hover {
    color: var(--ink-2);
  }

  /* плюс, который становится минусом */
  .faq__icon {
    position: relative;
    flex: none;
    width: 12px;
    height: 12px;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 12px;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease-out);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__answer {
    max-width: 62ch;
    padding-bottom: 20px;
    color: var(--ink-2);
    font-size: var(--t-text);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .faq__answer :global(a) {
    color: var(--ink);
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
  }

  @media (max-width: 859px) {
    .faq__label,
    .faq__steps,
    .faq__list,
    .faq__cta {
      grid-column: 1 / -1;
    }

    .faq__label {
      margin-bottom: 20px;
    }
  }
</style>
