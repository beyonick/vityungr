---
// Страница работы — у каждой из 181 работы каталога, и проданной тоже.
// Слева фото крупно (если их несколько — миниатюры под ним), справа подробности, цена и масштаб
// рядом с листом A4. Ниже форма заявки (только для работ в продаже) и другие работы серии.
// Клик по фото открывает просмотр (scripts/art.ts), но снизу оно не выезжает — data-art-still.
import { getImage } from "astro:assets";
import OrderForm from "../../../components/OrderForm.astro";
import SectionHead from "../../../components/SectionHead.astro";
import Wall, { type WallItem } from "../../../components/Wall.astro";
import Base from "../../../layouts/Base.astro";
import { fieldNotes, seriesBySlug, seriesText } from "../../../data/series";
import { site } from "../../../data/site";
import { langOf, pathIn, plural, stripLang, tr } from "../../../i18n";
import {
  formatPrice,
  formatSize,
  loadImage,
  mediumOf,
  mediumSize,
  orderHref,
  priceOrState,
  ratioOf,
  seriesOrder,
  sizeCm,
  slugOf,
  stateLabel,
  titleOf,
  workHref,
  workId,
  works,
  type Work,
} from "../../../lib/works";

export function getStaticPaths() {
  return works.map((work) => ({ params: { series: work.series, slug: slugOf(work) }, props: { work } }));
}

interface Props {
  work: Work;
}

const { work: w } = Astro.props;
const lang = langOf(Astro.currentLocale);
const t = tr(lang);
const s = seriesBySlug(w.series);
const st = seriesText(s, lang);
const name = titleOf(w, lang);
const isNew = s.slug === "new";
const available = w.status === "available";
const list = seriesOrder(w.series);
const index = list.indexOf(w);
const prev = list.length > 1 ? list[(index - 1 + list.length) % list.length] : null;
const next = list.length > 1 ? list[(index + 1) % list.length] : null;
const note = fieldNotes.find((n) => n.work === workId(w));
const viewMeta = [mediumSize(w, lang), priceOrState(w, lang)].filter(Boolean).join(" · ");

// Фото: srcset из тех же размеров, что у карточек (800, 1100) и просмотра (1600) — новые файлы не плодим
const photos = await Promise.all(
  w.images.map(async (img) => {
    const image = await loadImage(img.src);
    const big = Math.min(image.width, 1600);
    const steps = [800, 1100].filter((x) => x < big);
    const [full, thumb, ...rest] = await Promise.all([
      getImage({ src: image, width: big, format: "webp", quality: 84 }),
      getImage({ src: image, width: Math.min(360, image.width), format: "webp", quality: 80 }),
      ...steps.map((width) => getImage({ src: image, width, format: "webp", quality: 80 })),
    ]);
    return {
      image,
      r: image.width / image.height,
      full: full.src,
      thumb: thumb.src,
      srcset: [...rest.map((v, k) => `${v.src} ${steps[k]}w`), `${full.src} ${big}w`].join(", "),
    };
  }),
);
const main = photos[0];
// Фото вписано в высоту экрана — узкие картины на десктопе занимают меньше ширины
const sizes = `(max-width: 859px) 92vw, ${Math.round(Math.min(56, 42 * main.r))}vw`;

// Масштаб: картина и лист A4 в одном масштабе. Самый высокий из двух — 170 px, и оба помещаются в колонку.
const size = sizeCm(w);
const A4 = { w: 21, h: 29.7 };
const unit = size
  ? `min(${(170 / Math.max(size.h, A4.h)).toFixed(3)}px, calc((100cqi - 28px) / ${(size.w + A4.w).toFixed(1)}))`
  : "";

const stateNote = {
  available: t(
    "No payment on the site: I’ll email you to agree on shipping, currency and payment.",
    "Оплаты на сайте нет: я напишу вам на почту, и мы договоримся о доставке, валюте и способе оплаты.",
  ),
  reserved: t(
    "Someone has reserved this painting. If the sale falls through, it will be back here.",
    "Эту картину забронировали. Если продажа сорвётся, она вернётся сюда.",
  ),
  sold: t(
    "This one has found its home. I paint places like this often, so ask me about something similar.",
    "Эта картина уже нашла свой дом. Я часто пишу похожие места — спросите меня о чём-нибудь похожем.",
  ),
  archive: t(
    "This painting isn’t available. Ask me about something similar.",
    "Эта картина не продаётся. Спросите меня о чём-нибудь похожем.",
  ),
}[w.status];

const others: WallItem[] = list
  .filter((x) => x !== w)
  .slice(0, 18)
  .map((x) => ({
    src: x.images[0].src,
    ratio: ratioOf(x),
    alt: `${titleOf(x, lang)}, ${mediumOf(x, lang).toLowerCase()}`,
    href: workHref(x),
    title: titleOf(x, lang),
    meta: mediumSize(x, lang),
    price: priceOrState(x, lang),
    order: orderHref(x),
  }));

// тот же адрес, что в canonical (Base.astro)
const url = new URL(pathIn(lang, stripLang(Astro.originPathname ?? Astro.url.pathname)), Astro.site).href;
const [medium, surface] = mediumOf(w).split(/ on /i);
const ld = {
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  name,
  url,
  image: new URL(main.image.src, Astro.site).href,
  artform: "Painting",
  artMedium: medium,
  artworkSurface: surface,
  ...(size && {
    width: { "@type": "Distance", name: `${size.w} cm` },
    height: { "@type": "Distance", name: `${size.h} cm` },
  }),
  ...(w.year && { dateCreated: String(w.year) }),
  creator: { "@type": "Person", name: site.fullName, alternateName: site.name, url: Astro.site?.href },
  ...(available &&
    w.price_eur && {
      offers: {
        "@type": "Offer",
        price: w.price_eur,
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
        url,
      },
    }),
};

const title = isNew ? name : `${name} · ${st.title}`;
const state = available ? formatPrice(w.price_eur) : stateLabel(w, lang);
const description = t(
  `${name}: original ${mediumSize(w).toLowerCase()} by ${site.name} (${site.fullName})${
    isNew ? "" : `, from the ${st.title} series`
  }. ${state}.`,
  `${name}: оригинал, ${mediumSize(w, lang).toLowerCase()}. Автор — ${site.name} (${site.fullNameRu})${
    isNew ? "" : `, серия «${st.title}»`
  }. ${state}.`,
);
const worksWord = (n: number) => t(n === 1 ? "work" : "works", plural(n, "работа", "работы", "работ"));
---

<Base title={title} description={description} image={main.image.src}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <article class="wk" aria-labelledby="work-title">
    <div class="wk__bar label">
      <nav class="wk__crumbs" aria-label={t("Breadcrumb", "Навигация")}>
        <a href="/works">{t("Works", "Работы")}</a>
        <span aria-hidden="true">/</span>
        <a href={`/works/${s.slug}`}>{st.title}</a>
      </nav>
      {
        prev && next && (
          <nav
            class="wk__pager"
            aria-label={isNew ? t("More new works", "Другие новые работы") : t(`More from ${st.title}`, `Ещё из серии «${st.title}»`)}
          >
            <a href={workHref(prev)} rel="prev" title={titleOf(prev, lang)}>
              <span aria-hidden="true">←</span> {t("Prev", "Назад")}
              <span class="sr-only">{t("ious", "")}: {titleOf(prev, lang)}</span>
            </a>
            <span class="num muted">
              {index + 1} / {list.length}
            </span>
            <a href={workHref(next)} rel="next" title={titleOf(next, lang)}>
              {t("Next", "Дальше")}
              <span class="sr-only">: {titleOf(next, lang)}</span> <span aria-hidden="true">→</span>
            </a>
          </nav>
        )
      }
    </div>

    <div class="wk__main">
      <div class="wk__media">
        <div class="wk__stage" data-stage>
          {
            photos.map((p, k) => (
              <img
                class:list={["wk__photo", { "is-active": k === 0 }]}
                src={p.full}
                srcset={p.srcset}
                sizes={sizes}
                width={p.image.width}
                height={p.image.height}
                alt={k === 0 ? `${name}, ${mediumOf(w, lang).toLowerCase()}` : `${name}, ${t("photo", "фото")} ${k + 1}`}
                loading={k === 0 ? "eager" : "lazy"}
                fetchpriority={k === 0 ? "high" : undefined}
                decoding="async"
                draggable="false"
                data-photo={k}
                data-art={p.full}
                data-art-ratio={p.r.toFixed(4)}
                data-art-title={name}
                data-art-meta={viewMeta}
                data-art-still
              />
            ))
          }
        </div>
        {
          photos.length > 1 && (
            <ul class="wk__thumbs" aria-label={t("Photos", "Фотографии")}>
              {photos.map((p, k) => (
                <li>
                  <button
                    type="button"
                    class:list={["wk__thumb", { "is-active": k === 0 }]}
                    style={`--r:${p.r.toFixed(4)}`}
                    aria-pressed={k === 0 ? "true" : "false"}
                    data-photo-btn={k}
                  >
                    <img src={p.thumb} alt="" loading="lazy" decoding="async" />
                    <span class="sr-only">
                      {t(`Photo ${k + 1} of ${photos.length}`, `Фото ${k + 1} из ${photos.length}`)}
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="wk__info">
        <p class="wk__state label" data-reveal="text">
          {available && w.label === "NEW" && <span class="wk__new">{t("New", "Новая")}</span>}
          <span class:list={{ muted: !available }}>{stateLabel(w, lang)}</span>
        </p>
        <h1 id="work-title" class="wk__title serif" data-reveal="text">{name}</h1>
        {available && <p class="wk__price num" data-reveal="text">{formatPrice(w.price_eur)}</p>}

        <div class="wk__act" data-reveal="text">
          {
            available ? (
              <a class="wk__cta" href="#request">
                <span>{t("Request this painting", "Оставить заявку")}</span>
                <span aria-hidden="true">→</span>
              </a>
            ) : (
              <a class="wk__cta wk__cta--ghost" href={`/order?work=other&like=${encodeURIComponent(name)}`}>
                <span>{t("Ask about a similar painting", "Спросить о похожей картине")}</span>
                <span aria-hidden="true">→</span>
              </a>
            )
          }
          <p class="wk__small muted">
            {stateNote}{" "}
            {available && <a class="ulink" href="/shipping">{t("Shipping and FAQ", "Доставка и вопросы")}</a>}
          </p>
        </div>

        <dl class="wk__facts" data-reveal="text">
          <div>
            <dt class="label muted">{t("Medium", "Техника")}</dt>
            <dd>{mediumOf(w, lang)}</dd>
          </div>
          {
            w.size && (
              <div>
                <dt class="label muted">{t("Size", "Размер")}</dt>
                <dd class="num">{formatSize(w.size, lang)}</dd>
              </div>
            )
          }
          {
            w.year && (
              <div>
                <dt class="label muted">{t("Year", "Год")}</dt>
                <dd class="num">{w.year}</dd>
              </div>
            )
          }
          <div>
            <dt class="label muted">{isNew ? t("In", "Раздел") : t("Series", "Серия")}</dt>
            <dd>
              <a class="ulink" href={`/works/${s.slug}`}>{st.title}</a>
            </dd>
          </div>
          {
            w.exhibition_work && (
              <div>
                <dt class="label muted">{t("Exhibited", "Выставка")}</dt>
                <dd>{t("Shown at an exhibition", "Была на выставке")}</dd>
              </div>
            )
          }
        </dl>

        {
          size && (
            <figure class="wk__scale" style={`--u:${unit}`} data-reveal="text">
              <div class="wk__scale-row">
                <span class="wk__scale-art" style={`--w:${size.w};--h:${size.h}`}>
                  <img src={main.thumb} alt="" loading="lazy" decoding="async" />
                </span>
                <span class="wk__scale-a4" aria-hidden="true">
                  <span class="label">A4</span>
                </span>
              </div>
              <figcaption class="muted">
                {t("To scale, next to an A4 sheet (21 × 29.7 cm)", "В масштабе, рядом с листом A4 (21 × 29,7 см)")}
              </figcaption>
            </figure>
          )
        }

        {
          note && (
            <blockquote class="wk__note" data-reveal="text">
              <p class="serif">{t(note.text, note.textRu)}</p>
              <footer class="label muted">{t("From my Instagram", "Из моего Instagram")}</footer>
            </blockquote>
          )
        }
      </div>
    </div>
  </article>

  {
    available && (
      <section class="section" id="request" aria-labelledby="request-title">
        <SectionHead
          n="—"
          label={t("Request", "Заявка")}
          aside={t("No payment on the site", "Без оплаты на сайте")}
          title={t("Request this painting", "Заявка на эту картину")}
          titleId="request-title"
        >
          <p>
            {
              t(
                "Leave your contacts and I’ll write back by email within a couple of days to agree on currency, payment and delivery.",
                "Оставьте контакты, и в течение пары дней я напишу вам на почту, чтобы договориться о валюте, оплате и доставке.",
              )
            }
          </p>
        </SectionHead>
        <OrderForm work={w} />
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="section" aria-labelledby="more-title">
        <SectionHead
          n="—"
          label={isNew ? t("New works", "Новые работы") : t("Series", "Серия")}
          aside={`${list.length} ${worksWord(list.length)}`}
          title={isNew ? t("More new works", "Ещё новые работы") : t(`More from ${st.title}`, `Ещё из серии «${st.title}»`)}
          titleId="more-title"
        >
          <p>{st.intro}</p>
        </SectionHead>
        <Wall items={others} height={210} rows={2} />
        <div class="sec-foot" data-reveal="text">
          <a class="tlink" href={`/works/${s.slug}`}>
            {
              isNew
                ? t(`All ${list.length} new works`, `Все новые работы · ${list.length}`)
                : t(`All ${list.length} works from ${st.title}`, `Все работы серии «${st.title}» · ${list.length}`)
            }
          </a>
        </div>
      </section>
    )
  }
</Base>

<style>
  .wk {
    padding-top: clamp(96px, 13vh, 140px);
  }

  /* ---------- Строка над работой: откуда пришли и соседние работы серии ---------- */
  .wk__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-inline: var(--gutter);
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  .wk__crumbs,
  .wk__pager {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .wk__crumbs span,
  .wk__crumbs a:first-child {
    color: var(--ink-3);
  }

  .wk__crumbs a,
  .wk__pager a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    white-space: nowrap;
    transition: color 0.3s var(--ease-soft);
  }

  .wk__crumbs a:hover,
  .wk__pager a:hover {
    color: var(--ink);
  }

  .wk__pager {
    gap: 18px;
  }

  .wk__pager a {
    gap: 6px;
    color: var(--ink-2);
  }

  /* ---------- Работа ---------- */
  .wk__main {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 1.8vw, 28px);
    margin-top: clamp(28px, 3.5vw, 52px);
    padding-inline: var(--gutter);
  }

  .wk__media {
    grid-column: 1 / span 7;
    align-self: start;
    position: sticky;
    top: 84px;
  }

  .wk__stage {
    display: grid;
    justify-items: center;
    gap: 32px;
  }

  .wk__photo {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: max(320px, calc(100svh - 240px));
    box-shadow: var(--shadow-lift);
    user-select: none;
    -webkit-user-drag: none;
  }

  /* с JS видно одно фото, остальные — по миниатюрам */
  :global(html.js) .wk__photo:not(.is-active) {
    display: none;
  }

  .wk__thumbs {
    display: none;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 22px;
  }

  :global(html.js) .wk__thumbs {
    display: flex;
  }

  .wk__thumb {
    position: relative;
    display: block;
    height: 56px;
    aspect-ratio: var(--r);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.3s var(--ease-soft);
  }

  .wk__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wk__thumb::after {
    content: "";
    position: absolute;
    inset: -4px;
    border: 1px solid var(--ink);
    opacity: 0;
    transition: opacity 0.3s var(--ease-soft);
  }

  .wk__thumb:hover,
  .wk__thumb.is-active {
    opacity: 1;
  }

  .wk__thumb.is-active::after {
    opacity: 1;
  }

  /* ---------- Подробности ---------- */
  .wk__info {
    grid-column: 9 / span 4;
    container-type: inline-size;
  }

  .wk__state {
    display: flex;
    gap: 12px;
  }

  .wk__new {
    padding: 0 7px;
    border: 1px solid var(--ink);
    border-radius: 999px;
  }

  .wk__title {
    margin-top: 14px;
    font-size: clamp(2rem, 1.2rem + 2.4vw, 3.5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .wk__price {
    margin-top: 18px;
    font-size: clamp(1.25rem, 1rem + 0.7vw, 1.625rem);
    line-height: 1.2;
  }

  .wk__act {
    margin-top: clamp(24px, 2.6vw, 36px);
  }

  .wk__cta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 0 32px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: var(--t-text);
    transition:
      background-color 0.35s var(--ease-soft),
      color 0.35s var(--ease-soft);
  }

  .wk__cta:hover,
  .wk__cta--ghost {
    background: var(--bg);
    color: var(--ink);
  }

  .wk__cta--ghost:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .wk__small {
    margin-top: 14px;
    max-width: 40ch;
    font-size: var(--t-small);
    line-height: 1.5;
  }

  .wk__facts {
    margin: clamp(32px, 3.4vw, 48px) 0 0;
    border-top: 1px solid var(--line);
  }

  .wk__facts > div {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding-block: 11px;
    border-bottom: 1px solid var(--line);
  }

  .wk__facts dd {
    margin: 0;
  }

  /* ---------- Масштаб ---------- */
  .wk__scale {
    margin-top: 32px;
  }

  .wk__scale-row {
    display: flex;
    align-items: flex-end;
    gap: 28px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }

  .wk__scale-art {
    display: block;
    flex: none;
    width: calc(var(--u) * var(--w));
    height: calc(var(--u) * var(--h));
    box-shadow: var(--shadow-rest);
  }

  .wk__scale-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wk__scale-a4 {
    display: grid;
    place-items: center;
    flex: none;
    width: calc(var(--u) * 21);
    height: calc(var(--u) * 29.7);
    border: 1px dashed rgb(0 0 0 / 0.3);
    color: var(--ink-3);
  }

  .wk__scale figcaption {
    margin-top: 10px;
    font-size: var(--t-small);
  }

  /* ---------- Из подписи в Instagram ---------- */
  .wk__note {
    margin: 32px 0 0;
    padding-left: 16px;
    border-left: 1px solid var(--ink);
  }

  .wk__note p {
    font-size: 1.0625rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .wk__note p::before {
    content: "“";
  }

  .wk__note p::after {
    content: "”";
  }

  .wk__note footer {
    margin-top: 8px;
  }

  @media (max-width: 859px) {
    .wk__media,
    .wk__info {
      grid-column: 1 / -1;
    }

    .wk__media {
      position: static;
    }

    .wk__photo {
      max-height: 72svh;
    }

    .wk__info {
      margin-top: 36px;
    }
  }

  @media (max-width: 599px) {
    .wk__bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .wk__cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  // Миниатюры переключают крупное фото; клик по нему открывает просмотр (scripts/art.ts)
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-photo-btn]"));
  if (stage && buttons.length) {
    const photos = Array.from(stage.querySelectorAll<HTMLImageElement>("[data-photo]"));
    buttons.forEach((btn) =>
      btn.addEventListener("click", () => {
        const k = btn.dataset.photoBtn;
        photos.forEach((p) => p.classList.toggle("is-active", p.dataset.photo === k));
        buttons.forEach((b) => {
          b.classList.toggle("is-active", b === btn);
          b.setAttribute("aria-pressed", String(b === btn));
        });
      }),
    );
  }
</script>
