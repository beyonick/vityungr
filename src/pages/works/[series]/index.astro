---
// Страница серии: вступление, работы в продаже, архив (проданные и остальные), другие серии.
// Порядок работ тот же, что у «Prev / Next» на странице работы (seriesOrder).
import SectionHead from "../../../components/SectionHead.astro";
import SeriesNav from "../../../components/SeriesNav.astro";
import Wall, { type WallItem } from "../../../components/Wall.astro";
import Base from "../../../layouts/Base.astro";
import { series, seriesText, type Series } from "../../../data/series";
import { langOf, plural, tr } from "../../../i18n";
import {
  coverOf,
  loadImage,
  mediumOf,
  mediumSize,
  orderHref,
  priceOrState,
  ratioOf,
  seriesOrder,
  titleOf,
  workHref,
  worksIn,
  type Work,
} from "../../../lib/works";

export function getStaticPaths() {
  return series.map((s) => ({ params: { series: s.slug }, props: { s } }));
}

interface Props {
  s: Series;
}

const { s } = Astro.props;
const lang = langOf(Astro.currentLocale);
const t = tr(lang);
const text = seriesText(s, lang);
const works = (n: number) => t(n === 1 ? "work" : "works", plural(n, "работа", "работы", "работ"));
const isNew = s.slug === "new";
const list = seriesOrder(s.slug);
const forSale = list.filter((w) => w.status === "available" || w.status === "reserved");
const archive = list.filter((w) => w.status === "sold" || w.status === "archive");
const cover = await loadImage(coverOf(s.slug, s.cover).images[0].src);

const card = (w: Work): WallItem => ({
  src: w.images[0].src,
  ratio: ratioOf(w),
  alt: `${titleOf(w, lang)}, ${mediumOf(w, lang).toLowerCase()}`,
  href: workHref(w),
  title: titleOf(w, lang),
  meta: mediumSize(w, lang),
  price: priceOrState(w, lang),
  order: orderHref(w),
});

// Другие серии — обложками, как на главной
const others: WallItem[] = series
  .filter((x) => x.slug !== s.slug && x.slug !== "new")
  .map((x) => {
    const c = coverOf(x.slug, x.cover);
    const { title, places } = seriesText(x, lang);
    const coverTitle = titleOf(c, lang);
    const n = worksIn(x.slug).length;
    return {
      src: c.images[0].src,
      ratio: ratioOf(c),
      alt: t(`${coverTitle}, from the ${title} series`, `${coverTitle}, из серии «${title}»`),
      href: `/works/${x.slug}`,
      title,
      price: x.years,
      meta: `${places} · ${n} ${works(n)}`,
      viewTitle: coverTitle,
      viewMeta: [t(`${title} series`, `Серия «${title}»`), mediumSize(c, lang), priceOrState(c, lang)]
        .filter(Boolean)
        .join(" · "),
      viewLinkLabel: t(`See the ${title} series`, `Смотреть серию «${title}»`),
    };
  });

const blocks = [
  { title: t("Available now", "Сейчас в продаже"), items: forSale, height: 250 },
  { title: t("Archive", "Архив"), items: archive, height: 190 },
].filter((b) => b.items.length);
const total = `${list.length} ${works(list.length)}`;
---

<Base
  title={isNew ? text.title : t(`${text.title} series`, `Серия «${text.title}»`)}
  description={t(
    `${text.intro} ${list.length} paintings by Vityungr${forSale.length ? `, ${forSale.length} available` : ""}.`,
    `${text.intro} ${total} Vityungr${forSale.length ? `, в продаже — ${forSale.length}` : ""}.`,
  )}
  image={cover.src}
>
  <section class="ser" aria-labelledby="series-title">
    <SectionHead
      n="—"
      label={isNew ? t("Works", "Работы") : t("Series", "Серия")}
      aside={[text.places, s.years].filter(Boolean).join(" · ")}
      title={text.title}
      titleId="series-title"
      level={1}
    >
      <p>{text.intro}</p>
      <p>
        {
          t(
            `${total}${forSale.length ? `, ${forSale.length} of them available now` : ", none available right now"}.`,
            `${total}${forSale.length ? `, из них в продаже — ${forSale.length}` : ", сейчас ни одна не продаётся"}.`,
          )
        }
      </p>
    </SectionHead>
    <SeriesNav current={s.slug} />

    {
      blocks.map((b, i) => (
        <div class="ser__block">
          <div class="ser__head label" data-reveal="text">
            <span>
              <span class="ser__n num">0{i + 1}</span>
              {b.title}
            </span>
            <span class="muted num">{b.items.length}</span>
          </div>
          <Wall items={b.items.map(card)} height={b.height} />
        </div>
      ))
    }
  </section>

  <section class="section" aria-labelledby="others-title">
    <SectionHead
      n="—"
      label={t("Series", "Серии")}
      aside={t(`${others.length} places`, `${others.length} ${plural(others.length, "место", "места", "мест")}`)}
      title={isNew ? t("Series", "Серии") : t("Other series", "Другие серии")}
      titleId="others-title"
    >
      <p>
        {
          t(
            "Every series grows out of a place I’ve lived in or travelled to.",
            "Каждая серия вырастает из места, где я жил или куда приезжал.",
          )
        }
      </p>
    </SectionHead>
    <Wall items={others} height={230} />
  </section>
</Base>

<style>
  .ser {
    padding-top: clamp(120px, 16vh, 180px);
  }

  .ser__block + .ser__block {
    margin-top: clamp(72px, 8vw, 128px);
  }

  .ser__head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 0 var(--gutter) clamp(24px, 2.6vw, 36px);
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .ser__n {
    display: inline-block;
    min-width: 3em;
    color: var(--ink-3);
  }
</style>
