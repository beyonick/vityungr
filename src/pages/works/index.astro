---
// Все работы в продаже
import SectionHead from "../../components/SectionHead.astro";
import SeriesNav from "../../components/SeriesNav.astro";
import Wall, { type WallItem } from "../../components/Wall.astro";
import Base from "../../layouts/Base.astro";
import { langOf, tr } from "../../i18n";
import { galleryOrder, mediumOf, mediumSize, orderHref, priceOrState, ratioOf, titleOf, workHref } from "../../lib/works";

const lang = langOf(Astro.currentLocale);
const t = tr(lang);
const all = galleryOrder();
const items: WallItem[] = all.map((w) => ({
  src: w.images[0].src,
  ratio: ratioOf(w),
  alt: `${titleOf(w, lang)}, ${mediumOf(w, lang).toLowerCase()}`,
  href: workHref(w),
  title: titleOf(w, lang),
  meta: mediumSize(w, lang),
  price: priceOrState(w, lang),
  order: orderHref(w),
}));
---

<Base
  title={t("Available works", "Работы в продаже")}
  description={t(
    "Original oil sketches and tempera paintings by Vityungr, available to order.",
    "Оригинальные этюды маслом и работы темперой Vityungr, которые можно заказать.",
  )}
>
  <section class="works" aria-labelledby="works-title">
    <SectionHead
      n="—"
      label={t("Originals", "Оригиналы")}
      aside={t(`${all.length} available`, `${all.length} в продаже`)}
      title={t("Available now", "Сейчас в продаже")}
      titleId="works-title"
    >
      {
        lang === "ru" ? (
          <Fragment>
            <p>
              Этюды маслом на толстом грунтованном картоне и несколько работ темперой на холсте, все подписаны. Каждая
              работа существует в одном экземпляре, большинство написаны на пленэре, с натуры.
            </p>
            <p>
              Заказ — это <a class="ulink" href="/order">заявка</a>, а не оплата: я напишу вам на почту, и мы договоримся
              о доставке и способе оплаты.
            </p>
          </Fragment>
        ) : (
          <Fragment>
            <p>
              Oil sketches on thick primed board and a few tempera paintings on canvas, all signed. Every piece is one of
              a kind; most were painted outdoors, from life.
            </p>
            <p>
              Ordering is a <a class="ulink" href="/order">request</a>, not a payment: I’ll email you to agree on
              shipping and how to pay.
            </p>
          </Fragment>
        )
      }
    </SectionHead>
    <SeriesNav />
    <Wall items={items} height={280} />
  </section>
</Base>

<style>
  .works {
    padding-top: clamp(120px, 16vh, 180px);
  }
</style>
