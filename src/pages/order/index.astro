---
// Заявка на картину или принт. /order?work=<серия>/<папка> или ?work=prints/<вид>/<папка> — с уже выбранным.
import OrderForm from "../../components/OrderForm.astro";
import SectionHead from "../../components/SectionHead.astro";
import Base from "../../layouts/Base.astro";
---

<Base
  title="Request a purchase"
  description="Request an original painting or a print by Vityungr. No payment on the site: I’ll email you to agree on shipping and payment."
>
  <section class="order" aria-labelledby="order-title">
    <SectionHead n="—" label="Order" aside="No payment on the site" title="Request a purchase" titleId="order-title" level={1}>
      <p>
        Choose a painting or a print and leave your contacts. I’ll write back by email within a couple of days to agree
        on currency, payment and delivery.
      </p>
      <p>Everything is wrapped by hand and packed within 1–3 working days. Prints ship free worldwide.</p>
    </SectionHead>
    <OrderForm />
  </section>
</Base>

<style>
  .order {
    padding-top: clamp(120px, 16vh, 180px);
  }
</style>
