---
// Заявка на картину. /order?work=<серия>/<папка> открывает форму с выбранной работой.
import OrderForm from "../../components/OrderForm.astro";
import SectionHead from "../../components/SectionHead.astro";
import Base from "../../layouts/Base.astro";
---

<Base title="Request a painting" description="Request an original painting by Vityungr. No payment on the site: I’ll email you to agree on shipping and payment.">
  <section class="order" aria-labelledby="order-title">
    <SectionHead n="—" label="Order" aside="No payment on the site" title="Request a painting" titleId="order-title" level={1}>
      <p>
        Choose a painting and leave your contacts. I’ll write back by email within a couple of days to agree on
        currency, payment and delivery.
      </p>
      <p>Every original is wrapped by hand, packed within 1–3 working days and shipped worldwide.</p>
    </SectionHead>
    <OrderForm />
  </section>
</Base>

<style>
  .order {
    padding-top: clamp(120px, 16vh, 180px);
  }
</style>
