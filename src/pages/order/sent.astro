---
// Сюда переводит api/order.php, если форму отправили без JS. С JS то же сообщение показывает сама форма.
import SectionHead from "../../components/SectionHead.astro";
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";
---

<Base title="Request sent" description="Your request has been sent." noindex>
  <section class="sent" aria-labelledby="sent-title">
    <SectionHead n="—" label="Order" aside="Request sent" title="Thank you." titleId="sent-title" level={1}>
      <p>Your request is on its way to me. I’ll write back by email within a couple of days.</p>
      <p>
        If nothing arrives, check the spam folder or write to me directly:{" "}
        <a class="tlink" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p><a class="tlink" href="/works">Back to the works</a></p>
    </SectionHead>
  </section>
</Base>

<style>
  .sent {
    padding-top: clamp(120px, 16vh, 180px);
    min-height: 70vh;
  }
</style>
