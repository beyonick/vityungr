---
import { artMeta, availableWorks, findWork, workHref } from "../../../lib/works";
import Artwork from "../Artwork.astro";
import Icon from "../Icon.astro";

// Коллаж: x/y — центр в % от экрана, w — ширина в vw, r — поворот, d — глубина (для параллакса и разлёта).
// m* — то же для мобильной раскладки (в % от блока под текстом); без m — не показываем на телефоне.
const pieces = [
  { id: "originals/new/fields", x: 13, y: 26, w: 17, r: -3, d: 1.2, mx: 30, my: 20, mw: 52 },
  { id: "originals/montenegro/budva-old-town", x: 31, y: 16, w: 9.5, r: 2, d: 0.7 },
  { id: "originals/bosnia/mostar", x: 52, y: 15, w: 9, r: -1.5, d: 0.5 },
  { id: "originals/montenegro/winter-in-the-mountains", x: 72, y: 19, w: 14, r: 2.5, d: 1, mx: 76, my: 30, mw: 42 },
  { id: "originals/serbia/belgrade-the-western-gate", x: 90, y: 38, w: 8.5, r: -2, d: 0.8 },
  { id: "originals/tempera/ivy", x: 85, y: 73, w: 12.5, r: 3, d: 1.3, mx: 26, my: 60, mw: 38 },
  { id: "originals/new/march-greens", x: 66, y: 87, w: 13, r: -2, d: 0.9, mx: 71, my: 70, mw: 46 },
  { id: "originals/turkey/kuzgunguk-istanbul", x: 45, y: 89, w: 7.5, r: 2, d: 0.6 },
  { id: "originals/new/moss", x: 24, y: 83, w: 10, r: -3, d: 1.1, mx: 48, my: 93, mw: 26 },
  { id: "originals/montenegro/olive-grove", x: 10, y: 67, w: 10.5, r: 2, d: 0.8 },
];

const items = pieces.map((p) => ({ ...p, work: findWork(p.id) }));
const count = availableWorks().length;
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="hero__stage" data-hero-stage>
    <div class="hero__field" aria-hidden="true">
      {
        items.map((p, i) => (
          <div
            class="piece"
            data-piece
            data-depth={p.d}
            data-mobile={p.mx === undefined ? "hide" : undefined}
            style={`--x:${p.x};--y:${p.y};--w:${p.w};--r:${p.r};--mx:${p.mx ?? 0};--my:${p.my ?? 0};--mw:${p.mw ?? 0}`}
          >
            <div class="piece__scatter" data-piece-scatter>
              <div class="piece__pointer" data-piece-pointer>
                <div class="piece__inner" data-piece-inner>
                  <Artwork
                    src={p.work.images[0].src}
                    alt=""
                    sizes={`(max-width: 759px) ${p.mw ?? 30}vw, ${Math.round(p.w * 1.1)}vw`}
                    widths={[240, 360, 520, 760]}
                    priority={i < 4}
                    zoom={{ title: p.work.title, meta: artMeta(p.work), href: workHref(p.work), hrefLabel: "View the work" }}
                  />
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="hero__copy" data-hero-copy>
      <p class="caps hero__eyebrow">Plein-air painter · Budva, Montenegro</p>
      <h1 id="hero-title" class="display hero__title" data-split="hero">Painted outdoors, in the places I live.</h1>
      <p class="lede hero__lede" data-hero-fade>
        Oil sketches from Montenegro, Serbia, Bosnia and Türkiye, and slow tempera pieces from the studio. Originals, signed
        prints and a monthly print club.
      </p>
      <div class="hero__cta" data-hero-fade>
        <a class="btn" href="#available">
          See available works <span class="muted-on-ink num">{count}</span>
        </a>
        <a class="link-arrow" href="/print-club">Join the Print Club <Icon name="arrow-right-linear" /></a>
      </div>
    </div>

    <p class="caps hero__side hero__side--l muted" aria-hidden="true">Oil on board</p>
    <p class="caps hero__side hero__side--r muted" aria-hidden="true">Painted from life</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
  }

  .hero__stage {
    position: relative;
    height: 100svh;
    min-height: 640px;
    max-height: 1100px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .hero__field {
    position: absolute;
    inset: 0;
  }

  .piece {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    width: calc(var(--w) * 1vw);
    translate: -50% -50%;
    rotate: calc(var(--r) * 1deg);
  }

  .piece img {
    width: 100%;
    box-shadow: var(--shadow-board);
  }

  .piece__scatter,
  .piece__pointer,
  .piece__inner {
    will-change: transform;
  }

  /* До старта анимации прячем только декоративный коллаж — текст виден сразу */
  :global(html.js:not(.reduced-motion):not(.motion-fallback)) .piece__inner {
    opacity: 0;
  }

  /* Заголовок ждёт разбивки на слова (максимум 2.5 с, см. Base.astro) */
  :global(html.js:not(.reduced-motion):not(.motion-fallback)) .hero__title {
    visibility: hidden;
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: clamp(18px, 2.2vw, 28px);
    width: min(820px, 100%);
    padding: 72px var(--gutter) 0;
  }

  .hero__title {
    font-size: var(--t-hero);
    max-width: 12ch;
  }

  .hero__lede {
    max-width: 44ch;
    color: var(--ink-soft);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 24px;
  }

  .muted-on-ink {
    opacity: 0.6;
    font-size: 0.85em;
  }

  .hero__side {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    z-index: 1;
  }

  .hero__side--l {
    left: var(--gutter);
    writing-mode: vertical-rl;
    rotate: 180deg;
  }

  .hero__side--r {
    right: var(--gutter);
    writing-mode: vertical-rl;
  }

  /* Широкий, но невысокий экран: ужимаем коллаж, чтобы не наезжал на текст */
  @media (min-width: 760px) and (max-aspect-ratio: 4/3) {
    .piece {
      width: calc(var(--w) * 0.8vw);
    }
  }

  @media (max-width: 759px) {
    .hero__stage {
      height: auto;
      min-height: 0;
      max-height: none;
      display: flex;
      flex-direction: column;
      padding-top: 96px;
    }

    .hero__copy {
      padding-top: 0;
      order: 1;
    }

    .hero__field {
      position: relative;
      order: 2;
      width: 100%;
      height: 118vw;
      margin-top: 28px;
    }

    .piece {
      left: calc(var(--mx) * 1%);
      top: calc(var(--my) * 1%);
      width: calc(var(--mw) * 1vw);
    }

    .piece[data-mobile="hide"],
    .hero__side {
      display: none;
    }
  }
</style>
