---
import { series } from "../../../data/series";
import { artMeta, availableWorks, contextPhoto, formatPrice, formatSize, workHref, workId } from "../../../lib/works";
import Artwork from "../Artwork.astro";
import Icon from "../Icon.astro";

const all = availableWorks();
const shown = all.slice(0, 8);
// У свежих работ серии ещё нет — показываем технику
const placeOf = (w: (typeof all)[number]) => series.find((s) => s.slug === w.series)?.title ?? w.medium;
const slugOf = (id: string) => id.split("/").pop();
---

<section class="section available" id="available" aria-labelledby="available-title">
  <div class="wrap">
    <div class="section-head">
      <p class="caps section-head__index"><span class="muted">02</span> Originals</p>
      <p class="caps muted"><span class="num">{all.length}</span> available</p>
    </div>

    <div class="available__head">
      <h2 id="available-title" class="display available__title" data-split>Available now</h2>
      <p class="muted available__note" data-reveal>
        Oil on thick primed board, signed on the back. Ordering is a request, not a payment: I’ll email you to agree on
        shipping and how to pay.
      </p>
    </div>

    <ul class="available__grid" role="list">
      {
        shown.map((w) => {
          const extra = contextPhoto(w);
          return (
            <li data-reveal-card>
              <a class="work-card" href={`/works/${w.series}/${slugOf(workId(w))}`}>
                <div class={`board ${extra ? "has-context" : ""}`}>
                  <Artwork
                    src={w.images[0].src}
                    alt={`${w.title}, ${w.medium.toLowerCase()}`}
                    sizes="(max-width: 759px) 44vw, (max-width: 1199px) 30vw, 22vw"
                    zoom={{ title: w.title, meta: artMeta(w), href: workHref(w), hrefLabel: "View and request" }}
                  />
                  {extra && (
                    <Artwork
                      class="work-card__context"
                      src={extra.src}
                      alt=""
                      sizes="(max-width: 759px) 44vw, (max-width: 1199px) 30vw, 22vw"
                    />
                  )}
                  {(w.label || w.old_price_eur) && (
                    <span class={`tag work-card__tag ${w.label === "NEW" ? "tag--accent" : ""}`}>
                      {w.label === "NEW" ? "New" : "Sale"}
                    </span>
                  )}
                </div>
                <div class="work-card__meta">
                  <h3 class="work-card__title">{w.title}</h3>
                  <p class="work-card__price num">
                    {w.old_price_eur && (
                      <s class="muted">
                        <span class="sr-only">was </span>
                        {formatPrice(w.old_price_eur)}
                      </s>
                    )}{" "}
                    {formatPrice(w.price_eur)}
                  </p>
                </div>
                <p class="work-card__sub muted">
                  {[w.size && formatSize(w.size), placeOf(w)].filter(Boolean).join(" · ")}
                </p>
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="available__more">
      <a class="btn btn--ghost" href="/works?filter=available">
        All available works <span class="num muted">{all.length}</span>
        <Icon name="arrow-right-linear" />
      </a>
      <a class="link-arrow" href="/order">How ordering and shipping work <Icon name="arrow-right-linear" /></a>
    </div>
  </div>
</section>

<style>
  .available__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    align-items: end;
    gap: 20px var(--gutter);
    margin-bottom: clamp(32px, 5vw, 64px);
  }

  .available__title {
    font-size: var(--t-h2);
  }

  .available__note {
    max-width: 46ch;
  }

  .available__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 44px) clamp(12px, 1.4vw, 20px);
  }

  .work-card {
    display: block;
    text-decoration: none;
  }

  .work-card .board {
    aspect-ratio: 1 / 1;
  }

  :global(.work-card__context) {
    position: absolute !important;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    object-fit: cover;
    box-shadow: none !important;
    opacity: 0;
    transform: scale(1.04) !important;
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.9s var(--ease-out) !important;
  }

  @media (hover: hover) {
    .work-card:hover :global(.work-card__context),
    .work-card:focus-visible :global(.work-card__context) {
      opacity: 1;
      transform: scale(1) !important;
    }
  }

  .work-card__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
  }

  .work-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-top: 12px;
  }

  .work-card__title {
    font-size: 1rem;
    font-weight: 540;
    line-height: 1.3;
  }

  .work-card__price {
    white-space: nowrap;
    font-weight: 540;
  }

  .work-card__price s {
    margin-right: 0.3em;
    font-weight: 400;
  }

  .work-card__sub {
    margin-top: 2px;
    font-size: var(--t-small);
  }

  .available__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  @media (max-width: 1199px) {
    .available__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 859px) {
    .available__head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 759px) {
    .available__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
